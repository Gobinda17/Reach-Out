generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  CUSTOMER
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags   Tag[]
  orders Order[]

  @@map("users")
}

model Otp {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String
  purpose    String    @default("login")
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone, consumedAt, expiresAt])
  @@map("otps")
}

// The tag catalogue. Prices are in paise so amounts stay integers all the way
// through to Razorpay. Orders snapshot `amountPaise` at purchase time, so
// changing a price here never rewrites what someone was already charged.
model Product {
  slug        String   @id
  name        String
  description String
  pricePaise  Int
  sortOrder   Int      @default(0)
  // Retiring a product hides it from the storefront while keeping the name
  // resolvable for orders and tags already sold under it.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Tag {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  product          String   @default("free-etag")
  name             String
  phone            String
  email            String?
  vehicleReg       String?
  vehicleMakeModel String?
  address          String?
  notes            String?
  createdById      Int?
  createdBy        User?    @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order Order?

  @@map("tags")
}

// A paid tag purchase. The customer's details are parked in `customerData` at
// checkout time and only become a real Tag once Razorpay's signature verifies —
// so an abandoned or failed payment never produces a tag.
model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  user              User        @relation(fields: [userId], references: [id])
  product           String
  amountPaise       Int
  currency          String      @default("INR")
  status            OrderStatus @default(CREATED)
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  customerData      Json
  tagId             Int?        @unique
  tag               Tag?        @relation(fields: [tagId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId, status])
  @@map("orders")
}
