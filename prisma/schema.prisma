generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  // Everything ADMIN can do, plus the exclusive right to create, promote,
  // demote or delete admin-level accounts. See lib/roles.js.
  SUPERADMIN
  ADMIN
  SALES
  CUSTOMER
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
}

enum TagRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String?
  // Optional number the "Emergency" contact route rings instead of the
  // owner's normal tag phone — set from the account page, never shown to
  // whoever scanned the tag. Falls back to the tag's own phone when unset;
  // see the "Emergency" resolution in app/api/tags/[code]/call/route.js.
  emergencyPhone String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags     Tag[]         @relation("TagOwner")
  orders   Order[]
  scans    Scan[]
  messages ScanMessage[]
  calls    Call[]

  // Seller-side: stock a seller holds, the requests they raised for it, and
  // (for admins) the requests they ruled on.
  stock            Tag[]        @relation("SellerStock")
  tagRequests      TagRequest[] @relation("RequestedBy")
  requestDecisions TagRequest[] @relation("DecidedBy")

  activity ActivityLog[] @relation("ActivityActor")

  @@map("users")
}

// An append-only audit trail of everything staff do — who, what, when. Read by
// the super admin at /admin/activity; nothing in the app ever updates or deletes
// a row, which is the point.
model ActivityLog {
  id      Int   @id @default(autoincrement())
  actorId Int?
  // SetNull, not Cascade: deleting an account must not erase what it did.
  actor   User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Snapshot of who acted, so the entry stays readable after the account is
  // deleted or its phone number changes.
  actorPhone String
  actorRole  Role?

  // Dotted key, e.g. "user.role" or "tag.bulk_generate" — see lib/activityLog.js.
  action      String
  targetType  String?
  targetLabel String?
  summary     String
  // Extra structured detail (changed field names, counts). Never secret values.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("activity_log")
}

// A seller asking admin for a batch of blank tags to hand out. Approving one
// mints that many unclaimed tags and assigns them to the seller as stock; the
// request itself stays as the paper trail for how they got there.
model TagRequest {
  id       Int    @id @default(autoincrement())
  sellerId Int
  seller   User   @relation("RequestedBy", fields: [sellerId], references: [id])
  product  String
  quantity Int
  note     String?

  status       TagRequestStatus @default(PENDING)
  decidedById  Int?
  decidedBy    User?            @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags Tag[]

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("tag_requests")
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  user              User        @relation(fields: [userId], references: [id])
  product           String
  amountPaise       Int
  currency          String      @default("INR")
  status            OrderStatus @default(CREATED)
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  customerData      Json
  tagId             Int?        @unique
  tag               Tag?        @relation(fields: [tagId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId, status])
  @@map("orders")
}

// Admin-editable config that overrides the matching env var at runtime — lets
// an admin switch providers or flip a dev-mode flag from /admin/settings
// without a redeploy. See lib/settings.js. Value is always a plain string;
// callers parse/compare it themselves (e.g. "true"/"false" for booleans).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Otp {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String
  purpose    String    @default("login")
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone, consumedAt, expiresAt])
  @@map("otps")
}

// The tag catalogue. Prices are in paise so amounts stay integers all the way
// through to Razorpay. Orders snapshot `amountPaise` at purchase time, so
// changing a price here never rewrites what someone was already charged.
model Product {
  slug        String   @id
  name        String
  description String
  pricePaise  Int
  sortOrder   Int      @default(0)
  // Retiring a product hides it from the storefront while keeping the name
  // resolvable for orders and tags already sold under it.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model Tag {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  product          String    @default("free-etag")
  // Null until claimed — admin-bulk-generated tags start with no owner and no
  // customer details, and are filled in when someone scans and claims one.
  name             String?
  phone            String?
  email            String?
  vehicleReg       String?
  vehicleMakeModel String?
  address          String?
  notes            String?
  createdById      Int?
  createdBy        User?     @relation("TagOwner", fields: [createdById], references: [id])
  // Seller stock. Orthogonal to createdById: assignedTo is the seller holding
  // the physical tag to hand out, createdById is the end customer who ends up
  // claiming it. A tag can have both — the seller keeps credit for the sale.
  assignedToId     Int?
  assignedTo       User?     @relation("SellerStock", fields: [assignedToId], references: [id])
  assignedAt       DateTime?
  requestId        Int?
  request          TagRequest? @relation(fields: [requestId], references: [id])
  // Set once, the moment an unclaimed tag is claimed — unlike updatedAt, later
  // edits (admin corrections, etc.) don't overwrite this.
  claimedAt        DateTime?
  // Fulfillment: set when admin ships the physical tag. Only meaningful for
  // addressed-but-not-yet-claimed tags (self-service orders) — a tag claimed
  // from blank stock is already in its owner's hands by definition.
  shippedAt        DateTime?
  // Set when admin exports a just-registered tag's card+address (Registered
  // tab) — tracks which of these have already been pulled for processing.
  downloadedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages ScanMessage[]
  scans    Scan[]
  calls    Call[]
  order    Order?

  @@index([assignedToId, createdAt])
  @@map("tags")
}

// A message left by someone who scanned a tag — lets them reach the owner
// without the owner's name, phone, or any other detail ever being shown to them.
// fromUserId records who sent it (when they were logged in) purely so that
// sender can see their own contact history — it's never exposed to the tag's
// owner, who still never learns who messaged them unless the sender opts in.
model ScanMessage {
  id         Int      @id @default(autoincrement())
  tagId      Int
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  message    String
  // Which of the preset reasons the sender picked on the scan page — see
  // lib/contactReasons.js. Null for messages sent before reasons existed.
  reason     String?
  fromName   String?
  fromPhone  String?
  fromUserId Int?
  fromUser   User?    @relation(fields: [fromUserId], references: [id])
  createdAt  DateTime @default(now())

  @@index([tagId, createdAt])
  @@index([fromUserId, createdAt])
  @@map("scan_messages")
}

// One row per time someone looks up a tag — via the public /t/[code] page or
// the in-app camera scanner. scannedById is null for anonymous visitors; it's
// only set to let a logged-in scanner see their own scan history.
model Scan {
  id          Int      @id @default(autoincrement())
  tagId       Int
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  scannedById Int?
  scannedBy   User?    @relation(fields: [scannedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([scannedById, createdAt])
  @@index([tagId, createdAt])
  @@map("scans")
}

// A masked-calling attempt: a virtual/proxy number allocated for a scanner to
// dial so the tag's owner can be reached without either side ever seeing the
// other's real number. `provider` is a config switch (see lib/calling.js) —
// "dev" allocates a placeholder number and connects nothing for local
// development; a real provider (Exotel, Twilio, ...) replaces it later
// without changing this table's shape. `callerPhone` is kept so a provider's
// routing webhook (see app/api/webhooks/edesy/route.js) can be told which
// real number to bridge a masked call to — the owner's number is looked up
// via `tag`, so this is the other half of that pair.
model Call {
  id             Int      @id @default(autoincrement())
  tagId          Int
  tag            Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  initiatedById  Int?
  initiatedBy    User?    @relation(fields: [initiatedById], references: [id])
  reason         String?
  provider       String
  virtualNumber  String
  callerPhone    String?
  // Resolved once at allocation time: the tag owner's emergencyPhone when
  // `reason` is "emergency" and one is set, otherwise the tag's normal
  // phone — see app/api/tags/[code]/call/route.js. Nullable only so older
  // rows (created before this column existed) fall back to tag.phone at
  // routing time; every call created from now on always sets it.
  targetPhone    String?
  providerCallId String?
  status         String   @default("allocated")
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([initiatedById, createdAt])
  @@index([tagId, createdAt])
  @@map("calls")
}
